generator client {
  provider = "prisma-client-js"
  // Sem `output` explícito, o pnpm gera dentro de um diretório do store que o
  // `tsc` não alcança — `@prisma/client` compila como se não exportasse nada.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Instituicao {
  id                   String                 @id @default(uuid())
  nome                 String
  cnpj                 String?                @unique
  endereco             String?
  telefone             String?
  email                String?
  logoFileName         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  updatedByEmail       String?
  planoId              String?
  parceiroPiloto       Boolean                @default(false)
  planoAtribuidoEm     DateTime?
  planoAtribuidoPor    String?
  plano                Plano?                 @relation(fields: [planoId], references: [id])
  users                Users[]
  eventos              Eventos[]
  areas                Area[]
  participantes        Participantes[]
  produtosEvento       ProdutosEvento[]
  participanteProdutos ParticipanteProdutos[]
  parcelas             Parcela[]
  projetos             Projeto[]
  mercadoPagoAccount   MercadoPagoAccount?
  assinaturas          Assinatura[]
  pagamentos           Pagamento[]

  @@index([planoId])
  @@map("instituicoes")
}

model Users {
  id             String      @id @default(uuid())
  email          String      @unique
  nome           String
  telefone       String?
  rg             String?
  cpf            String?     @unique
  userType       String      @default("membro") // membro | backoffice | lider | pastor | tesouraria
  instituicaoId  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  updatedByEmail String?
  active         Boolean     @default(true)
  pix_key        String?
  instituicao    Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  eventos        Eventos[]
  areas          UserArea[]
  userRoles      UserRole[]
  projetos       Projeto[]   @relation("ProjetoLider")

  @@index([instituicaoId])
  @@index([email])
  @@index([cpf])
  @@map("users")
}

model Area {
  id             String      @id @default(uuid())
  nome           String
  instituicaoId  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  updatedByEmail String?
  instituicao    Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  users          UserArea[]

  @@index([instituicaoId])
  @@map("areas")
}

model UserArea {
  id         String   @id @default(uuid())
  userId     String
  areaId     String
  roleNaArea String // "lider", "voluntario", "coordenador"
  createdAt  DateTime @default(now())
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@index([userId])
  @@index([areaId])
  @@map("user_areas")
}

model Eventos {
  id                    String             @id @default(uuid())
  nome                  String
  descricao             String?
  faq                   Json?
  userId                String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  updatedByEmail        String?
  data_fim              DateTime
  data_inicio           DateTime
  data_maxima_inscricao DateTime?
  imagem_url            String?
  instituicaoId         String?
  limite_inscricoes     Int?
  statusId              String?            @unique
  selecao_unica_produto Boolean            @default(true)
  enviar_email_qr_code  Boolean            @default(false)
  user                  Users?             @relation(fields: [userId], references: [id])
  instituicao           Instituicao?       @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  status                StatusEvento?      @relation(fields: [statusId], references: [id], onDelete: SetNull)
  participantes         Participantes[]
  produtos              ProdutosEvento[]
  camposCustomizados    CampoCustomizado[]

  @@index([userId])
  @@index([instituicaoId])
  @@index([statusId])
  @@map("eventos")
}

model CampoCustomizado {
  id          String                @id @default(uuid())
  eventoId    String
  label       String
  tipo        String                @default("texto")
  obrigatorio Boolean               @default(false)
  oculto      Boolean               @default(false)
  opcoes      Json?
  ordem       Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  evento      Eventos               @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  respostas   RespostaCustomizada[]

  @@index([eventoId])
  @@map("campos_customizados")
}

model RespostaCustomizada {
  id             String           @id @default(uuid())
  participanteId String
  campoId        String
  valor          String?
  valores        Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  participante   Participantes    @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  campo          CampoCustomizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([participanteId, campoId])
  @@index([participanteId])
  @@index([campoId])
  @@map("respostas_customizadas")
}

model StatusEvento {
  id            String   @id @default(uuid())
  nome          String
  justificativa String?
  evento        Eventos?

  @@map("status_eventos")
}

model Participantes {
  id                     String                 @id @default(uuid())
  pagamentos             Pagamento[]
  eventoId               String
  nome                   String?
  email                  String?
  telefone               String?
  termo_assinado         Boolean?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  updatedByEmail         String?
  cpf                    String?
  isDeleted              Boolean                @default(false)
  rg                     String?
  instituicaoId          String?
  presenca_confirmada    Boolean                @default(false)
  presenca_confirmada_em DateTime?
  token_presenca         String?                @unique
  evento                 Eventos                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  instituicao            Instituicao?           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  produtos               ParticipanteProdutos[]
  respostasCustomizadas  RespostaCustomizada[]

  @@unique([eventoId, cpf])
  @@index([eventoId])
  @@index([instituicaoId])
  @@map("participantes")
}

model ProdutosEvento {
  id             String                 @id @default(uuid())
  eventoId       String
  nome           String
  descricao      String?
  valor          Decimal
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  updatedByEmail String?
  exigePagamento Boolean                @default(false)
  oculto         Boolean                @default(false)
  instituicaoId  String?
  evento         Eventos                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  instituicao    Instituicao?           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  participantes  ParticipanteProdutos[]

  @@index([eventoId])
  @@index([instituicaoId])
  @@map("produtos_evento")
}

model ParticipanteProdutos {
  id                  String         @id @default(uuid())
  participanteId      String
  produtoId           String
  valor_pago          Decimal
  data_pagamento      DateTime?
  createdAt           DateTime       @default(now())
  quantidade_parcelas Int            @default(1)
  updatedAt           DateTime       @default(now()) @updatedAt
  updatedByEmail      String?
  instituicaoId       String?
  parcelas            Parcela[]
  pagamentos          Pagamento[]
  participante        Participantes  @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  produto             ProdutosEvento @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  instituicao         Instituicao?   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@unique([participanteId, produtoId])
  @@index([participanteId])
  @@index([produtoId])
  @@index([instituicaoId])
  @@map("participante_produtos")
}

model Parcela {
  id                    String               @id @default(uuid())
  participanteProdutoId String
  valor_pago            Decimal              @default(0)
  metodo_pagamento      String?
  numero_vezes          Int?
  descricao             String?
  data_pagamento        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  updatedByEmail        String?
  instituicaoId         String?
  participanteProduto   ParticipanteProdutos @relation(fields: [participanteProdutoId], references: [id], onDelete: Cascade)
  instituicao           Instituicao?         @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  pagamento             Pagamento?

  @@index([participanteProdutoId])
  @@index([instituicaoId])
  @@map("parcelas")
}

// ==================== RBAC SYSTEM ====================

model Role {
  id          String           @id @default(uuid())
  nome        String           @unique
  descricao   String?
  nivel       Int              @default(0) // hierarquia: admin=100, pastor=90, etc
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  recurso   String // "eventos", "financeiro", "usuarios"
  acao      String // "criar", "editar", "excluir", "visualizar"
  descricao String?
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  @@unique([recurso, acao])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ==================== PROJETOS ====================

model Projeto {
  id             String         @id @default(uuid())
  nome           String
  descricao      String?
  ideias         String?
  data_inicio    DateTime?
  data_fim       DateTime?
  instituicaoId  String
  liderUserId    String
  eventoId       String?
  statusId       String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  updatedByEmail String?
  instituicao    Instituicao    @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  lider          Users          @relation("ProjetoLider", fields: [liderUserId], references: [id])
  status         StatusProjeto? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  itens          ItemProjeto[]
  anexos         AnexoProjeto[]

  @@index([instituicaoId])
  @@index([liderUserId])
  @@index([statusId])
  @@map("projetos")
}

model ItemProjeto {
  id         String   @id @default(uuid())
  projetoId  String
  nome       String
  descricao  String?
  quantidade Int      @default(1)
  valor_unit Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projeto    Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("itens_projeto")
}

model StatusProjeto {
  id            String   @id @default(uuid())
  nome          String // em_analise | aprovado | recusado | em_reembolso | liquidado | finalizado
  justificativa String?
  aprovadoPorId String?
  projeto       Projeto?

  @@map("status_projeto")
}

model AnexoProjeto {
  id        String   @id @default(uuid())
  projetoId String
  tipo      String // nota_fiscal | comprovante_pagamento
  nome      String
  url       String
  tamanho   Int?
  createdAt DateTime @default(now())
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("anexos_projeto")
}

// ==================== PLANOS E PAGAMENTOS ====================

model Plano {
  id        String  @id @default(uuid())
  codigo    String  @unique // PILOTO_FREE | ESSENCIAL | PRO
  nome      String
  descricao String?

  // Cobrança de assinatura SaaS
  cobrancaSaaS        Boolean  @default(true) // false => plano gratuito, nunca gera Assinatura
  valorMensal         Decimal  @default(0)
  valorAnual          Decimal?
  mpPreapprovalPlanId String? // id do plano no MP (só se cobrancaSaaS)

  // Fee sobre pagamentos de evento (split)
  feeEventoPercentual Decimal  @default(0) // ex.: 3.50 == 3,5%
  feeEventoMinimo     Decimal  @default(0) // piso em R$ por transação
  feeEventoMaximo     Decimal? // teto em R$ por transação (null = sem teto)

  // Limites / features
  limiteEventosAtivos Int? // null = ilimitado
  limiteUsuarios      Int? // null = ilimitado
  features            Json @default("{}")

  ativo Boolean @default(true)
  ordem Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instituicoes Instituicao[]
  assinaturas  Assinatura[]

  @@index([codigo])
  @@map("planos")
}

model MercadoPagoAccount {
  id            String      @id @default(uuid())
  instituicaoId String      @unique
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  mpUserId     String // user_id do MP da igreja
  accessToken  String // AES-256-GCM em repouso
  refreshToken String // AES-256-GCM em repouso
  publicKey    String // usado pelo Payment Brick no frontend
  scope        String?
  expiresAt    DateTime
  status       MercadoPagoAccountStatus @default(PENDING)

  ultimoRefreshEm DateTime?
  ultimoErro      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instituicaoId])
  @@index([status])
  @@map("mercado_pago_accounts")
}

enum MercadoPagoAccountStatus {
  PENDING // OAuth iniciado, aguardando autorização
  ACTIVE // conectado e funcional
  EXPIRED // token expirado, precisa reautorizar
  REVOKED // igreja desconectou
}

// Nonce de uso único do `state` do OAuth. Consumido no callback (SPEC-BE-002).
model OAuthNonce {
  nonce         String    @id
  instituicaoId String
  consumidoEm   DateTime?
  expiraEm      DateTime
  createdAt     DateTime  @default(now())

  @@index([expiraEm])
  @@map("oauth_nonces")
}

model Assinatura {
  id            String      @id @default(uuid())
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  planoId String
  plano   Plano  @relation(fields: [planoId], references: [id])

  mpPreapprovalId    String           @unique
  valor              Decimal
  periodicidade      String           @default("mensal") // mensal | anual
  status             AssinaturaStatus @default(PENDING)
  proximaCobranca    DateTime?
  canceladaEm        DateTime?
  motivoCancelamento String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instituicaoId])
  @@index([planoId])
  @@index([status])
  @@map("assinaturas")
}

enum AssinaturaStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
}

model Pagamento {
  id            String      @id @default(uuid())
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  participanteId String
  participante   Participantes @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  participanteProdutoId String?
  participanteProduto   ParticipanteProdutos? @relation(fields: [participanteProdutoId], references: [id])

  parcelaId String?  @unique
  parcela   Parcela? @relation(fields: [parcelaId], references: [id])

  mpPaymentId    String          @unique
  idempotencyKey String          @unique // header X-Idempotency-Key enviado ao MP
  status         PagamentoStatus @default(PENDING)
  statusDetail   String?

  valor                 Decimal
  applicationFee        Decimal // snapshot da comissão no momento da criação
  feePercentualAplicado Decimal // snapshot do Plano.feeEventoPercentual usado
  metodoPagamento       String? // credit_card | pix | bolbradesco
  parcelasCartao        Int     @default(1)

  aprovadoEm DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([instituicaoId])
  @@index([participanteId])
  @@index([participanteProdutoId])
  @@index([status])
  @@index([status, createdAt]) // suporta o job de reconciliação (SPEC-BE-006)
  @@map("pagamentos")
}

enum PagamentoStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

model WebhookLog {
  id           String    @id @default(uuid())
  mpEventId    String // data.id do MP
  tipo         String // payment | subscription_preapproval
  action       String? // payment.created | payment.updated
  payload      Json
  processado   Boolean   @default(false)
  erro         String?
  tentativas   Int       @default(0)
  processadoEm DateTime?
  createdAt    DateTime  @default(now())

  @@unique([mpEventId, tipo, action])
  @@index([processado])
  @@map("webhook_logs")
}
