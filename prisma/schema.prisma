generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Instituicao {
  id                    String                 @id @default(uuid())
  nome                  String
  cnpj                  String?                @unique
  endereco              String?
  telefone              String?
  email                 String?
  logoFileName          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  updatedByEmail        String?
  planoId               String?
  planoAtribuidoEm      DateTime?
  planoAtribuidoPor     String?
  parceiroPiloto        Boolean                @default(false)
  // Overrides de split. null = herda o valor do plano.
  splitTipo             TipoSplit?
  splitValorFixo        Decimal?
  splitPercentual       Decimal?
  splitMinimo           Decimal?
  splitMaximo           Decimal?
  splitObservacao       String?
  users                 Users[]
  eventos               Eventos[]
  areas                 Area[]
  participantes         Participantes[]
  produtosEvento        ProdutosEvento[]
  participanteProdutos  ParticipanteProdutos[]
  parcelas              Parcela[]
  projetos              Projeto[]
  plano                 Plano?                 @relation(fields: [planoId], references: [id])
  pagbankAccount        PagBankAccount?
  assinaturas           Assinatura[]
  pagbankPagamentos     PagBankPagamento[]
  contasBancarias       ContaBancaria[]
  categoriasFinanceiras CategoriaFinanceira[]
  fornecedores          Fornecedor[]
  transacoesBancarias   TransacaoBancaria[]
  regrasConciliacao     RegraConciliacao[]
  ocorrenciasCalendario OcorrenciaCalendario[]

  @@index([planoId])
  @@map("instituicoes")
}

model Users {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  nome                  String
  telefone              String?
  rg                    String?
  cpf                   String?                @unique
  userType              String                 @default("membro") // membro | backoffice | lider | pastor | tesouraria
  instituicaoId         String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  updatedByEmail        String?
  active                Boolean                @default(true)
  pix_key               String?
  instituicao           Instituicao            @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  eventos               Eventos[]
  areas                 UserArea[]
  userRoles             UserRole[]
  projetos              Projeto[]              @relation("ProjetoLider")
  ocorrenciasCalendario OcorrenciaCalendario[]

  @@index([instituicaoId])
  @@index([email])
  @@index([cpf])
  @@map("users")
}

model Area {
  id             String      @id @default(uuid())
  nome           String
  cor            String?
  instituicaoId  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  updatedByEmail String?
  instituicao    Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  users          UserArea[]

  transacoesBancarias TransacaoBancaria[]
  regrasConciliacao   RegraConciliacao[]
  ocorrencias         OcorrenciaArea[]
  projetos            ProjetoArea[]

  @@index([instituicaoId])
  @@map("areas")
}

model UserArea {
  id         String   @id @default(uuid())
  userId     String
  areaId     String
  roleNaArea String // "lider", "voluntario", "coordenador"
  createdAt  DateTime @default(now())
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@index([userId])
  @@index([areaId])
  @@map("user_areas")
}

// ==================== CALENDARIO ====================
// Ocorrencias sao entidades proprias do Calendario, distintas de Eventos.
// Eventos continua sem recorrencia/area e aparece no calendario apenas
// via leitura no frontend (nao ha relacao no banco entre Eventos e Area).

model OcorrenciaCalendario {
  id                String   @id @default(uuid())
  titulo            String
  nota              String?
  dataInicio        DateTime
  dataFim           DateTime
  horaInicioDefault String
  horaFimDefault    String
  instituicaoId     String
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedByEmail    String?

  instituicao Instituicao                @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  user        Users?                     @relation(fields: [userId], references: [id])
  areas       OcorrenciaArea[]
  excecoes    OcorrenciaHorarioExcecao[]

  @@index([instituicaoId])
  @@index([dataInicio, dataFim])
  @@map("ocorrencias_calendario")
}

model OcorrenciaArea {
  id           String   @id @default(uuid())
  ocorrenciaId String
  areaId       String
  createdAt    DateTime @default(now())

  ocorrencia OcorrenciaCalendario @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  area       Area                 @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([ocorrenciaId, areaId])
  @@index([areaId])
  @@map("ocorrencias_areas")
}

model OcorrenciaHorarioExcecao {
  id           String   @id @default(uuid())
  ocorrenciaId String
  data         DateTime
  horaInicio   String
  horaFim      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ocorrencia OcorrenciaCalendario @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)

  @@unique([ocorrenciaId, data])
  @@index([ocorrenciaId])
  @@map("ocorrencias_horario_excecoes")
}

model Eventos {
  id                    String             @id @default(uuid())
  nome                  String
  descricao             String?
  faq                   Json?
  userId                String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  updatedByEmail        String?
  data_fim              DateTime
  data_inicio           DateTime
  data_maxima_inscricao DateTime?
  imagem_url            String?
  instituicaoId         String?
  limite_inscricoes     Int?
  statusId              String?
  justificativa         String?
  selecao_unica_produto Boolean            @default(true)
  enviar_email_qr_code  Boolean            @default(false)
  template_formulario   String             @default("padrao")
  user                  Users?             @relation(fields: [userId], references: [id])
  instituicao           Instituicao?       @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  status                StatusEvento?      @relation(fields: [statusId], references: [id], onDelete: SetNull)
  participantes         Participantes[]
  produtos              ProdutosEvento[]
  camposCustomizados    CampoCustomizado[]

  @@index([userId])
  @@index([instituicaoId])
  @@index([statusId])
  @@map("eventos")
}

model CampoCustomizado {
  id          String                @id @default(uuid())
  eventoId    String
  label       String
  tipo        String                @default("texto")
  obrigatorio Boolean               @default(false)
  oculto      Boolean               @default(false)
  opcoes      Json?
  ordem       Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  evento      Eventos               @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  respostas   RespostaCustomizada[]

  @@index([eventoId])
  @@map("campos_customizados")
}

model RespostaCustomizada {
  id             String           @id @default(uuid())
  participanteId String
  campoId        String
  valor          String?
  valores        Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  participante   Participantes    @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  campo          CampoCustomizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([participanteId, campoId])
  @@index([participanteId])
  @@index([campoId])
  @@map("respostas_customizadas")
}

model StatusEvento {
  id      String    @id @default(uuid())
  nome    String    @unique
  eventos Eventos[]

  @@map("status_eventos")
}

model Participantes {
  id                     String                 @id @default(uuid())
  eventoId               String
  nome                   String?
  email                  String?
  telefone               String?
  termo_assinado         Boolean?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  updatedByEmail         String?
  cpf                    String?
  isDeleted              Boolean                @default(false)
  rg                     String?
  instituicaoId          String?
  presenca_confirmada    Boolean                @default(false)
  presenca_confirmada_em DateTime?
  token_presenca         String?                @unique
  evento                 Eventos                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  instituicao            Instituicao?           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  produtos               ParticipanteProdutos[]
  respostasCustomizadas  RespostaCustomizada[]

  @@unique([eventoId, cpf])
  @@index([eventoId])
  @@index([instituicaoId])
  @@map("participantes")
}

model ProdutosEvento {
  id             String                 @id @default(uuid())
  eventoId       String
  nome           String
  descricao      String?
  valor          Decimal
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  updatedByEmail String?
  exigePagamento Boolean                @default(false)
  oculto         Boolean                @default(false)
  instituicaoId  String?
  evento         Eventos                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  instituicao    Instituicao?           @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  participantes  ParticipanteProdutos[]

  @@index([eventoId])
  @@index([instituicaoId])
  @@map("produtos_evento")
}

model ParticipanteProdutos {
  id                  String         @id @default(uuid())
  participanteId      String
  produtoId           String
  valor_pago          Decimal
  data_pagamento      DateTime?
  createdAt           DateTime       @default(now())
  quantidade_parcelas Int            @default(1)
  updatedAt           DateTime       @default(now()) @updatedAt
  updatedByEmail      String?
  instituicaoId       String?
  parcelas            Parcela[]
  participante        Participantes  @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  produto             ProdutosEvento @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  instituicao         Instituicao?   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@unique([participanteId, produtoId])
  @@index([participanteId])
  @@index([produtoId])
  @@index([instituicaoId])
  @@map("participante_produtos")
}

model Parcela {
  id                    String               @id @default(uuid())
  participanteProdutoId String
  valor_pago            Decimal              @default(0)
  metodo_pagamento      String?
  numero_vezes          Int?
  descricao             String?
  data_pagamento        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  updatedByEmail        String?
  instituicaoId         String?
  participanteProduto   ParticipanteProdutos @relation(fields: [participanteProdutoId], references: [id], onDelete: Cascade)
  instituicao           Instituicao?         @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([participanteProdutoId])
  @@index([instituicaoId])
  @@map("parcelas")
}

// ==================== RBAC SYSTEM ====================

model Role {
  id          String           @id @default(uuid())
  nome        String           @unique
  descricao   String?
  nivel       Int              @default(0) // hierarquia: admin=100, pastor=90, etc
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  recurso   String // "eventos", "financeiro", "usuarios"
  acao      String // "criar", "editar", "excluir", "visualizar"
  descricao String?
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  @@unique([recurso, acao])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ==================== PROJETOS ====================

model Projeto {
  id             String         @id @default(uuid())
  nome           String
  descricao      String?
  ideias         String?
  data_inicio    DateTime?
  data_fim       DateTime?
  instituicaoId  String
  liderUserId    String
  eventoId       String?
  statusId       String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  updatedByEmail String?
  instituicao    Instituicao    @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  lider          Users          @relation("ProjetoLider", fields: [liderUserId], references: [id])
  status         StatusProjeto? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  itens          ItemProjeto[]
  anexos         AnexoProjeto[]
  areas          ProjetoArea[]

  transacoesBancarias TransacaoBancaria[]
  regrasConciliacao   RegraConciliacao[]

  @@index([instituicaoId])
  @@index([liderUserId])
  @@index([statusId])
  @@map("projetos")
}

model ProjetoArea {
  id        String   @id @default(uuid())
  projetoId String
  areaId    String
  createdAt DateTime @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([projetoId, areaId])
  @@index([areaId])
  @@map("projetos_areas")
}

model ItemProjeto {
  id         String   @id @default(uuid())
  projetoId  String
  nome       String
  descricao  String?
  quantidade Int      @default(1)
  valor_unit Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projeto    Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("itens_projeto")
}

model StatusProjeto {
  id            String   @id @default(uuid())
  nome          String // em_analise | aprovado | recusado | em_reembolso | liquidado | finalizado
  justificativa String?
  aprovadoPorId String?
  projeto       Projeto?

  @@map("status_projeto")
}

model AnexoProjeto {
  id        String   @id @default(uuid())
  projetoId String
  tipo      String // nota_fiscal | comprovante_pagamento
  nome      String
  url       String
  tamanho   Int?
  createdAt DateTime @default(now())
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("anexos_projeto")
}

// ==================== PLANOS E PAGBANK ====================
// Estrutura isolada. Nao substitui nem alimenta Parcela/ParticipanteProdutos.
// Integracao anterior era Mercado Pago; migrada por completo para PagBank
// (migration 20260828000000_pagbank). Sem tabela de compatibilidade: o
// historico de pagamentos Mercado Pago foi descartado (decisao do produto).

/**
 * Como a taxa da plataforma é calculada sobre uma inscrição paga.
 * PERCENTUAL usa percentual + piso/teto; FIXO cobra um valor em reais,
 * independente do preço do produto.
 */
enum TipoSplit {
  PERCENTUAL
  FIXO
}

enum PagBankAccountStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

// Cobre os status de charge documentados pela API de Pedidos (Orders) do
// PagBank. WAITING é o estado de um QR Code Pix ainda nao pago.
enum PagBankPagamentoStatus {
  WAITING
  IN_ANALYSIS
  AUTHORIZED
  PAID
  DECLINED
  CANCELED
  REFUNDED
}

enum AssinaturaStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Plano {
  id                  String        @id @default(uuid())
  codigo              String        @unique
  nome                String
  descricao           String?
  cobrancaSaaS        Boolean       @default(true)
  valorMensal         Decimal       @default(0)
  valorAnual          Decimal?
  // PLAN_xxxx criado na API de Assinaturas do PagBank (api.assinaturas.pagseguro.com).
  pagbankPlanoId      String?
  // Padroes de split herdados pelas instituicoes.
  // Nomes feeEvento* preservados: as colunas ja existem no banco com dados.
  feeEventoTipo       TipoSplit     @default(PERCENTUAL)
  feeEventoValorFixo  Decimal       @default(0)
  feeEventoPercentual Decimal       @default(0)
  feeEventoMinimo     Decimal       @default(0)
  feeEventoMaximo     Decimal?
  limiteEventosAtivos Int?
  limiteUsuarios      Int?
  features            Json          @default("{}")
  ativo               Boolean       @default(true)
  ordem               Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  instituicoes        Instituicao[]
  assinaturas         Assinatura[]

  @@index([codigo])
  @@map("planos")
}

/**
 * Mensalidade da instituicao com a PLATAFORMA (nao confundir com PagBankPagamento,
 * que sao as inscricoes pagas de eventos). Cobrada via API de Assinaturas do
 * PagBank (produto separado do Orders/Connect: conta unica da plataforma,
 * cartao do responsavel pela instituicao, sem OAuth por instituicao).
 */
model Assinatura {
  id                  String           @id @default(uuid())
  instituicaoId       String
  planoId             String
  // SUBS_xxxx / CUST_xxxx da API de Assinaturas.
  pagbankAssinaturaId String           @unique
  pagbankAssinanteId  String?
  cardBrand           String?
  cardUltimosDigitos  String?
  valor               Decimal
  periodicidade       String           @default("mensal")
  status              AssinaturaStatus @default(PENDING)
  proximaCobranca     DateTime?
  canceladaEm         DateTime?
  motivoCancelamento  String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  instituicao         Instituicao      @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  plano               Plano            @relation(fields: [planoId], references: [id])

  @@index([instituicaoId])
  @@index([planoId])
  @@index([status])
  @@map("assinaturas")
}

model PagBankAccount {
  id               String               @id @default(uuid())
  instituicaoId    String               @unique
  // account_id devolvido pelo OAuth Connect (ACCO_xxxx) — o vendedor/collector.
  pagbankAccountId String
  accessTokenEnc   String // AES-256-GCM
  refreshTokenEnc  String
  scope            String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  status           PagBankAccountStatus @default(PENDING)
  ultimoRefreshEm  DateTime?
  ultimoErro       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  instituicao      Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
  @@index([status])
  @@map("pagbank_accounts")
}

// State anti-CSRF do fluxo OAuth + verifier do PKCE. Nome generico: nao e
// especifico de nenhum provedor, reaproveitavel por qualquer OAuth futuro.
model OAuthNonce {
  nonce         String    @id
  instituicaoId String
  codeVerifier  String    @default("")
  consumidoEm   DateTime?
  expiraEm      DateTime
  createdAt     DateTime  @default(now())

  @@index([expiraEm])
  @@map("oauth_nonces")
}

// participanteId / participanteProdutoId sao referencias FRACAS (sem @relation)
// para nao adicionar campos de volta nos models de inscricao.
model PagBankPagamento {
  id                      String                 @id @default(uuid())
  instituicaoId           String
  participanteId          String
  participanteProdutoId   String?
  eventoId                String?
  // ORDE_xxxx / CHAR_xxxx da API de Pedidos (Orders).
  pagbankOrderId          String?                @unique
  pagbankChargeId         String?                @unique
  externalReference       String                 @unique
  status                  PagBankPagamentoStatus @default(WAITING)
  statusDetail            String?
  valor                   Decimal
  splitValor              Decimal
  splitPercentualAplicado Decimal
  metodoPagamento         String?
  parcelasCartao          Int                    @default(1)
  // Pix: QR Code exibido na nossa tela de pagamento (nao ha checkout hospedado
  // quando ha split — ver docs/pagbank-implementacao.md).
  qrCodeTexto             String?
  qrCodeImagemUrl         String?
  boletoUrl               String?
  expiraEm                DateTime?
  aprovadoEm              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  instituicao             Instituicao            @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([instituicaoId])
  @@index([participanteId])
  @@index([participanteProdutoId])
  @@index([eventoId])
  @@index([status])
  @@index([status, createdAt])
  @@map("pagbank_pagamentos")
}

// PagBank nao envia um id de evento distinto: reenvia o recurso (Order/Charge)
// inteiro a cada mudanca de status. A dedup e pelo hash do corpo bruto — dois
// envios com o mesmo status para o mesmo recurso tem o mesmo hash.
model PagBankWebhookLog {
  id              String    @id @default(uuid())
  payloadHash     String    @unique
  // Valor do header x-product-origin (ex.: "ORDER").
  origem          String
  pagbankOrderId  String?
  pagbankChargeId String?
  payload         Json
  processado      Boolean   @default(false)
  erro            String?
  tentativas      Int       @default(0)
  processadoEm    DateTime?
  createdAt       DateTime  @default(now())

  @@index([processado])
  @@index([pagbankOrderId])
  @@map("pagbank_webhook_logs")
}

// ==================== CONCILIACAO BANCARIA ====================
// Tabelas ja existentes no banco (migration 20260718000000_conciliacao_bancaria),
// com dados. Modeladas aqui para o schema refletir o banco. Fora do escopo da
// integracao Mercado Pago.

model ContaBancaria {
  id               String              @id @default(uuid())
  instituicaoId    String
  banco            String // "237" = Bradesco
  agencia          String
  conta            String
  digito           String?
  descricao        String?
  saldoInicial     Decimal             @default(0)
  dataSaldoInicial DateTime?
  ativo            Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  updatedByEmail   String?
  instituicao      Instituicao         @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  transacoes       TransacaoBancaria[]

  @@index([instituicaoId])
  @@map("contas_bancarias")
}

model CategoriaFinanceira {
  id             String              @id @default(uuid())
  nome           String
  tipo           String // RECEITA | DESPESA
  instituicaoId  String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  updatedByEmail String?
  instituicao    Instituicao         @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  transacoes     TransacaoBancaria[]
  regras         RegraConciliacao[]

  @@unique([instituicaoId, nome, tipo])
  @@index([instituicaoId])
  @@map("categorias_financeiras")
}

model Fornecedor {
  id             String              @id @default(uuid())
  nome           String
  cnpjCpf        String?
  telefone       String?
  email          String?
  observacao     String?
  instituicaoId  String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  updatedByEmail String?
  instituicao    Instituicao         @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  transacoes     TransacaoBancaria[]
  regras         RegraConciliacao[]

  @@unique([instituicaoId, nome])
  @@index([instituicaoId])
  @@map("fornecedores")
}

model TransacaoBancaria {
  id              String   @id @default(uuid())
  contaBancariaId String
  instituicaoId   String
  dataMovimento   DateTime
  valor           Decimal
  tipo            String // CREDITO | DEBITO
  codigoBanco     String
  descricaoBanco  String
  descricaoAbrev  String?
  historico       String?
  documento       String?
  saldoApos       Decimal?
  hashDedup       String   @unique
  categoriaId     String?
  fornecedorId    String?
  projetoId       String?
  areaId          String?
  conciliada      Boolean  @default(false)
  regraAplicadaId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByEmail  String?

  contaBancaria ContaBancaria        @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
  instituicao   Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  categoria     CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  fornecedor    Fornecedor?          @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  projeto       Projeto?             @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  area          Area?                @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([contaBancariaId])
  @@index([instituicaoId])
  @@index([dataMovimento])
  @@index([categoriaId])
  @@index([fornecedorId])
  @@index([projetoId])
  @@index([areaId])
  @@map("transacoes_bancarias")
}

model RegraConciliacao {
  id             String   @id @default(uuid())
  instituicaoId  String
  nome           String?
  campo          String
  operador       String
  valor          String
  tipoTransacao  String?
  categoriaId    String?
  fornecedorId   String?
  projetoId      String?
  areaId         String?
  prioridade     Int      @default(0)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?

  instituicao Instituicao          @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  fornecedor  Fornecedor?          @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  projeto     Projeto?             @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  area        Area?                @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([instituicaoId])
  @@index([categoriaId])
  @@index([fornecedorId])
  @@index([projetoId])
  @@index([areaId])
  @@map("regras_conciliacao")
}
