{
  "version": 2,
  "functions": {
    "src/server.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/jobs/refresh-tokens", "schedule": "0 3 * * *" },
    { "path": "/jobs/reconciliar-pagamentos", "schedule": "*/30 * * * *" },
    { "path": "/jobs/verificar-assinaturas", "schedule": "0 4 * * *" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
