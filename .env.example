# Server Configuration
NODE_ENV="development"
PORT=3001

# Supabase Configuration
SUPABASE_URL="https://[XPTO].supabase.co"
SUPABASE_ANON_KEY="[XPTO]"
SUPABASE_SERVICE_ROLE_KEY="[XPTO]"

# Database Configuration (for Prisma)
DATABASE_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET="[XPTO]"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Recaptcha
RECAPTCHA_SECRET_KEY="[XPTO]"
RESEND_API_KEY="XPTO"
RESEND_FROM_EMAIL="sistema@contato.igrejaformosadecristo.com"

# URLs (usadas em redirects de OAuth e no notification_url do webhook)
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3000"

# Plano resolvido quando instituicao.planoId e nulo
PLANO_PADRAO_CODIGO="PILOTO_FREE"

# MERCADO PAGO — conta DA PLATAFORMA (assinatura SaaS)
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# MERCADO PAGO — app de marketplace (OAuth das igrejas / split payment)
# redirect_uri precisa ser byte a byte igual ao cadastrado no painel do MP
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
MERCADO_PAGO_REDIRECT_URI="http://localhost:3000/payment-connect/callback"

# Cifra dos tokens OAuth em repouso — gerar com: openssl rand -hex 32
MP_TOKEN_ENCRYPTION_KEY=""

# Protege as rotas de /jobs (Vercel Cron injeta como Bearer)
CRON_SECRET=""