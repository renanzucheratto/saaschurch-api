# Server Configuration
NODE_ENV="development"
PORT=3001

# Supabase Configuration
SUPABASE_URL="https://[XPTO].supabase.co"
SUPABASE_ANON_KEY="[XPTO]"
SUPABASE_SERVICE_ROLE_KEY="[XPTO]"

# Database Configuration (for Prisma)
DATABASE_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET="[XPTO]"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Recaptcha
RECAPTCHA_SECRET_KEY="[XPTO]"
RESEND_API_KEY="XPTO"
RESEND_FROM_EMAIL="sistema@contato.igrejaformosadecristo.com"

# URLs públicas
# API_URL monta notification_url e redirect_uri; FRONTEND_URL monta as back_urls.
# Em dev, apontar para a URL HTTPS do túnel (ngrok/cloudflared) — localhost não
# é aceito pelo PagBank.
API_URL="https://api.exemplo.com"
FRONTEND_URL="http://localhost:4000"

# PagBank — sandbox/production alternado por PAGBANK_ENV
# Painel: https://developer.pagbank.com.br
PAGBANK_ENV="sandbox"

# App de marketplace (Connect — OAuth das igrejas / split de pagamento).
PAGBANK_APP_ID="[XPTO]"
PAGBANK_CLIENT_SECRET="[XPTO]"
# Precisa bater caractere por caractere com a URL cadastrada no painel.
PAGBANK_REDIRECT_URI="https://api.exemplo.com/pagbank/oauth/callback"

# Token de acesso da conta DA PLATAFORMA (não da instituição). Autentica a
# troca de código OAuth (Connect) e a API de Assinaturas (mensalidade).
PAGBANK_ACCESS_TOKEN="[XPTO]"

# ACCO_xxxx da conta da PLATAFORMA — receiver do split que representa a
# taxa da plataforma em cada pedido de evento pago.
PAGBANK_PLATAFORMA_ACCOUNT_ID="[XPTO]"

# Cifragem dos tokens OAuth das instituições em repouso (AES-256-GCM).
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Perder esta chave obriga TODAS as instituições a reconectar a conta.
PAGBANK_TOKEN_ENCRYPTION_KEY="[XPTO]"

# Planos e split
# Código do plano atribuído a instituição nova / usado como fallback.
PLANO_PADRAO_CODIGO="PILOTO_FREE"
# Percentual usado apenas na CRIAÇÃO do plano padrão pelo seed.
SPLIT_PERCENTUAL_PADRAO="5"

# Bearer do cron de refresh de tokens (POST /jobs/refresh-pagbank-tokens)
CRON_SECRET="[XPTO]"