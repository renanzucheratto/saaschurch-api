# Server Configuration
NODE_ENV="development"
PORT=3001

# Supabase Configuration
SUPABASE_URL="https://[XPTO].supabase.co"
SUPABASE_ANON_KEY="[XPTO]"
SUPABASE_SERVICE_ROLE_KEY="[XPTO]"

# Database Configuration (for Prisma)
DATABASE_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[XPTO]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET="[XPTO]"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Recaptcha
RECAPTCHA_SECRET_KEY="[XPTO]"
RESEND_API_KEY="XPTO"
RESEND_FROM_EMAIL="sistema@contato.igrejaformosadecristo.com"

# URLs públicas
# API_URL monta notification_url e redirect_uri; FRONTEND_URL monta as back_urls.
# Em dev, apontar para a URL HTTPS do túnel (ngrok) — localhost não é aceito pelo MP.
API_URL="https://api.exemplo.com"
FRONTEND_URL="http://localhost:3000"

# Mercado Pago
# Painel: https://www.mercadopago.com.br/developers/panel
MERCADO_PAGO_APP_ID="[XPTO]"
MERCADO_PAGO_CLIENT_ID="[XPTO]"
MERCADO_PAGO_CLIENT_SECRET="[XPTO]"
MERCADO_PAGO_ACCESS_TOKEN="[XPTO]"
MERCADO_PAGO_PUBLIC_KEY="[XPTO]"
# Precisa bater caractere por caractere com a URL cadastrada no painel do MP.
MERCADO_PAGO_REDIRECT_URI="https://api.exemplo.com/mercadopago/oauth/callback"
# Assinatura secreta exibida no painel ao configurar o webhook. Valida x-signature.
MERCADO_PAGO_WEBHOOK_SECRET="[XPTO]"
MERCADO_PAGO_ENV="sandbox"

# Cifragem dos tokens OAuth das instituições em repouso (AES-256-GCM).
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Perder esta chave obriga TODAS as instituições a reconectar a conta.
MP_TOKEN_ENCRYPTION_KEY="[XPTO]"

# Planos e split
# Código do plano atribuído a instituição nova / usado como fallback.
PLANO_PADRAO_CODIGO="PILOTO_FREE"
# Percentual usado apenas na CRIAÇÃO do plano padrão pelo seed.
SPLIT_PERCENTUAL_PADRAO="5"

# Bearer do cron de refresh de tokens (POST /jobs/refresh-mp-tokens)
CRON_SECRET="[XPTO]"